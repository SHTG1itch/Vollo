# ─── Vollo API environment ────────────────────────────────────────────────
# Copy to `.env` and fill in. Every value below has a working local default
# that matches docker-compose.yml, so `cp .env.example .env` is enough to run
# against the local PostGIS container.

# Server
PORT=4000
NODE_ENV=development

# Postgres + PostGIS connection.
# Local docker-compose default:
DATABASE_URL=postgres://vollo:vollo@localhost:5432/vollo
# Supabase free tier looks like:
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# When using a hosted provider that requires TLS, set:
DATABASE_SSL=false
# Verify the DB server's TLS certificate (set true in production with a trusted CA).
DATABASE_SSL_STRICT=false

# Auth
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# Geocoding (free tiers). Nominatim needs a contact string in the User-Agent.
GEOCODER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Vollo/0.1 (you@example.com)
# Optional Geoapify key (2,500 req/day free) — used when GEOCODER=geoapify
GEOAPIFY_API_KEY=

# Geospatial domination engine tuning
TERRITORY_RADIUS_KM=10
TERRITORY_MIN_COURTS=3
LEADERBOARD_WINDOW_DAYS=30

# Streak / temporal heat index tuning
STREAK_WINDOW_DAYS=7
STREAK_MODIFIER_STEP=0.1
STREAK_MODIFIER_MAX=2.0

# CORS — comma separated origins, or * for any (dev only)
CORS_ORIGIN=*
