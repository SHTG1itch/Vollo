{
  "expo": {
    "name": "Vollo",
    "slug": "vollo",
    "scheme": "vollo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F4F6F3",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#F4F6F3",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vollo.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vollo uses your location to find courts near you and map your territories."
      }
    },
    "android": {
      "package": "app.vollo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F7A3D"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      "expo-notifications",
      "expo-asset",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_REVERSED_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vollo needs access to your photos so you can set a profile or cover photo and add photos to a match.",
          "cameraPermission": "Vollo needs camera access so you can take a photo for your profile or a match."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://pfophuqopwfupxjonsty.supabase.co/functions/v1",
      "supabaseUrl": "https://pfophuqopwfupxjonsty.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBmb3BodXFvcHdmdXB4am9uc3R5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI1MTE1NTksImV4cCI6MjA5ODA4NzU1OX0.xl6PXZC1iUasQZ5RsTgnIuQmoN2RzzsmWdDGtHssnP4",
      "googleWebClientId": "958415288431-fol1pk22asmc748feuvbo1gkntcegis2.apps.googleusercontent.com",
      "googleIosClientId": "",
      "googleAuthEnabled": true,
      "eas": {
        "projectId": "0be07316-2872-4688-afad-404a26ef890d"
      }
    }
  }
}
