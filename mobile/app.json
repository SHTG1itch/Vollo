{
  "expo": {
    "name": "Vollo",
    "slug": "vollo",
    "scheme": "vollo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "backgroundColor": "#F4F6F3",
    "splash": {
      "backgroundColor": "#F4F6F3",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vollo.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vollo uses your location to find courts near you and map your territories."
      }
    },
    "android": {
      "package": "app.vollo.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-location",
      "expo-notifications",
      "expo-asset",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_REVERSED_IOS_CLIENT_ID"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://pfophuqopwfupxjonsty.supabase.co/functions/v1",
      "supabaseUrl": "https://pfophuqopwfupxjonsty.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBmb3BodXFvcHdmdXB4am9uc3R5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI1MTE1NTksImV4cCI6MjA5ODA4NzU1OX0.xl6PXZC1iUasQZ5RsTgnIuQmoN2RzzsmWdDGtHssnP4",
      "googleWebClientId": "958415288431-fol1pk22asmc748feuvbo1gkntcegis2.apps.googleusercontent.com",
      "googleIosClientId": ""
    }
  }
}
